<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/futuristicbg"
    android:padding="18sp">

    <TextView
        android:id="@+id/textViewMatchHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22sp"
        android:fontFamily="@font/russo_one"
        android:shadowColor="#80FFD700"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="MATCH REPORT"
        android:textColor="#FFD700"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10sp"
        android:layout_marginHorizontal="34sp"
        app:layout_constraintTop_toBottomOf="@id/textViewMatchHistoryTitle"
        android:background="#40FFFFFF" />
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imageViewPlayerProfile"
        android:layout_width="80sp"
        android:layout_height="80sp"
        android:src="@drawable/defaultdp"
        app:civ_border_color="#2C91E6"
        android:layout_marginTop="54sp"
        android:layout_marginStart="6sp"
        app:civ_border_width="2sp"
        app:layout_constraintTop_toBottomOf="@id/textViewMatchHistoryTitle"
        app:layout_constraintEnd_toStartOf="@+id/textViewMatchResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/textViewMatchResult"
         />
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imageViewOpponentProfile"
        android:layout_width="80sp"
        android:layout_height="80sp"
        android:src="@drawable/defaultdp"
        app:civ_border_color="#E62C2C"
        app:civ_border_width="2sp"
        android:layout_marginEnd="6sp"
        android:layout_marginTop="54sp"
        app:layout_constraintBottom_toBottomOf="@id/textViewMatchResult"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewMatchResult"
        app:layout_constraintTop_toBottomOf="@id/textViewMatchHistoryTitle" />
    <TextView
        android:id="@+id/textViewPlayerName"
        android:layout_width="120sp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/russo_one"
        android:textColor="#2C91E6"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="12sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        app:layout_constraintBottom_toTopOf="@id/textViewMatchTimestamp"
        app:layout_constraintEnd_toEndOf="@id/imageViewPlayerProfile"
        app:layout_constraintStart_toStartOf="@id/imageViewPlayerProfile"
        app:layout_constraintTop_toBottomOf="@id/imageViewPlayerProfile"
        tools:text="You" />
    <TextView
        android:id="@+id/textViewOpponentName"
        android:layout_width="120sp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/russo_one"
        android:textColor="#E62C2C"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="14sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        app:layout_constraintBottom_toTopOf="@id/textViewMatchTimestamp"
        app:layout_constraintEnd_toEndOf="@id/imageViewOpponentProfile"
        app:layout_constraintStart_toStartOf="@id/imageViewOpponentProfile"
        app:layout_constraintTop_toBottomOf="@id/imageViewOpponentProfile"
        tools:text="Opponent" />
    <TextView
        android:id="@+id/textViewVs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/russo_one"
        android:text="VS"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/imageViewOpponentProfile"
        app:layout_constraintStart_toEndOf="@id/imageViewPlayerProfile"
        app:layout_constraintTop_toTopOf="@id/imageViewPlayerProfile" />
    <TextView
        android:id="@+id/textViewMatchResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4sp"
        android:background="@drawable/victory_banner_background"
        android:fontFamily="@font/russo_one"
        android:paddingHorizontal="16sp"
        android:paddingVertical="2sp"
        android:rotation="-3"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="@id/textViewVs"
        app:layout_constraintStart_toStartOf="@id/textViewVs"
        app:layout_constraintTop_toBottomOf="@id/textViewVs"
        app:layout_constraintBottom_toBottomOf="@id/imageViewPlayerProfile"
        tools:text="VICTORY" />
    <TextView
        android:id="@+id/textViewMatchTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Played: 5 mins ago"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginTop="2sp"
        android:fontFamily="@font/noah_bold"
        app:layout_constraintBottom_toTopOf="@id/performance_card"
        app:layout_constraintTop_toBottomOf="@+id/textViewOpponentName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.cardview.widget.CardView
        android:id="@+id/performance_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12sp"
        app:cardBackgroundColor="#44000000"
        app:cardCornerRadius="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textViewPuzzle"
        app:layout_constraintTop_toBottomOf="@id/textViewMatchTimestamp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16sp">

            <include layout="@layout/stat_comparison_row" android:id="@+id/rating_row"/>
            <include layout="@layout/stat_comparison_row" android:id="@+id/avg_time_row"/>
            <include layout="@layout/stat_comparison_row" android:id="@+id/accuracy_row"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/textViewPuzzle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24sp"
        android:background="@drawable/puzzle_bg"
        android:fontFamily="@font/russo_one"
        android:paddingHorizontal="26sp"
        android:paddingVertical="12sp"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.03"
        android:textSize="26sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeStepGranularity="1sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textViewFeedback"
        app:layout_constraintTop_toBottomOf="@+id/performance_card"
        tools:text="Solve: 123456 = 100" />
    <TextView
        android:id="@+id/textViewFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feedback: Well done!"
        android:textSize="18sp"
        android:textColor="#FFD700"
        android:textAlignment="center"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:paddingHorizontal="10sp"
        android:fontFamily="@font/noah_bold"
        app:layout_constraintBottom_toTopOf="@id/solutions_card"
        app:layout_constraintTop_toBottomOf="@+id/textViewPuzzle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8sp" />
    <androidx.cardview.widget.CardView
        android:id="@+id/solutions_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"
        android:layout_marginBottom="20sp"
        app:cardBackgroundColor="#6A000000"
        app:cardCornerRadius="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewFeedback">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16sp">

            <TextView
                android:id="@+id/textViewSolutionsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8sp"
                android:fontFamily="@font/russo_one"
                android:text="Possible Solutions:"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="3"/>
            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8sp"
                android:gravity="center_vertical|start"
                android:paddingVertical="10sp">
                <ImageView
                    android:layout_width="26sp"
                    android:layout_height="26sp"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/my_primary" />
                <TextView
                    android:id="@+id/textViewSolution1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16sp"
                    android:layout_marginEnd="16sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/russo_one"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeStepGranularity="1sp"
                    tools:text="1+2+3+4=10" />

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginHorizontal="36sp"
                app:layout_constraintTop_toBottomOf="@id/textViewMatchHistoryTitle"
                android:background="#40FFFFFF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8sp"
                android:gravity="center_vertical|start"
                android:paddingVertical="10sp">
                <ImageView
                    android:layout_width="26sp"
                    android:layout_height="26sp"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/my_primary" />
                <TextView
                    android:id="@+id/textViewSolution2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16sp"
                    android:layout_marginEnd="16sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/russo_one"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeStepGranularity="1sp"
                    tools:text="1+2+3+4=10" />

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginHorizontal="36sp"
                app:layout_constraintTop_toBottomOf="@id/textViewMatchHistoryTitle"
                android:background="#40FFFFFF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8sp"
                android:gravity="center_vertical|start"
                android:paddingVertical="10sp">
                <ImageView
                    android:layout_width="26sp"
                    android:layout_height="26sp"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/my_primary" />
                <TextView
                    android:id="@+id/textViewSolution3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16sp"
                    android:layout_marginEnd="16sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/russo_one"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeStepGranularity="1sp"
                    tools:text="1+2+3+4=10" />

            </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>